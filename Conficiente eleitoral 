<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulador Eleitoral Brasil</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f5f7fa;
      color: #1a1a1a;
      margin: 0;
      padding: 16px;
      line-height: 1.5;
    }
    .container {
      max-width: 1000px;
      margin: auto;
    }
    h1 {
      text-align: center;
      color: #1a237e;
      margin-bottom: 4px;
      font-size: 1.6rem;
    }
    .subtitle {
      text-align: center;
      color: #666;
      margin-top: 0;
      font-size: 0.85rem;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 14px 0;
    }
    .card {
      background: #fff;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid #e0e0e0;
    }
    .card-blue { background: #e3f2fd; border-color: #90caf9; }
    .card-amber { background: #fff8e1; border-color: #ffe082; }
    .card-green { background: #e8f5e9; border-color: #a5d6a7; }
    .card-pink { background: #fce4ec; border-color: #f8bbd0; }
    .card-orange { background: #fff3e0; border-color: #ffcc80; }
    label {
      font-weight: 700;
      font-size: 13px;
      display: block;
      margin-bottom: 5px;
    }
    select, input[type="number"] {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin: 12px 0;
    }
    .stat-box {
      text-align: center;
      padding: 12px;
      border-radius: 10px;
    }
    .stat-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .stat-value {
      font-size: 20px;
      font-weight: 800;
      color: #1a237e;
      margin-top: 4px;
    }
    .toolbar {
      background: #f5f5f5;
      padding: 10px 14px;
      border-radius: 8px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .btn {
      padding: 6px 14px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 12px;
      color: #fff;
    }
    .btn-primary { background: #5c6bc0; }
    .btn-danger { background: #ef5350; }
    .btn-success { background: #43a047; }
    .table-wrap {
      max-height: 420px;
      overflow-y: auto;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      background: #fff;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead {
      position: sticky;
      top: 0;
      background: #1a237e;
      color: #fff;
      z-index: 2;
    }
    th, td {
      padding: 8px 10px;
      text-align: left;
    }
    th { font-size: 12px; }
    td { border-bottom: 1px solid #f0f0f0; }
    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      display: inline-block;
    }
    .party-sigla { font-weight: 700; font-size: 13px; }
    .party-nome { font-size: 11px; color: #666; }
    .right { text-align: right; }
    .center { text-align: center; }
    .eleitos { font-weight: 800; font-size: 15px; color: #1a237e; }
    .eleitos-zero { color: #bbb; }
    .sobra-sim { color: #2e7d32; font-weight: 700; }
    .result-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 14px;
    }
    .result-card {
      padding: 12px;
      border-radius: 10px;
      border-left: 4px solid;
    }
    .result-card h4 { margin: 0 0 5px; font-size: 13px; }
    .result-card p { margin: 3px 0; font-size: 12px; }
    .summary {
      background: #1a237e;
      color: #fff;
      padding: 14px;
      border-radius: 10px;
      margin-top: 10px;
      text-align: center;
    }
    .summary h3 { margin: 4px 0; font-size: 22px; }
    .summary small { opacity: 0.8; font-size: 12px; }
    .input-votos {
      width: 100%;
      min-width: 120px;
      padding: 6px 8px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 13px;
      text-align: right;
    }
    @media (max-width: 600px) {
      .grid-2, .grid-3, .result-grid { grid-template-columns: 1fr; }
      .toolbar { flex-direction: column; align-items: flex-start; }
    }
  </style>
<base target="_blank">
</head>
<body>
<div class="container">
  <h1>🗳️ Simulador Eleitoral Brasil</h1>
  <p class="subtitle">Todos os 30 partidos · Vereador, Deputado Estadual, Federal e Senador</p>

  <div class="grid-2">
    <div class="card card-blue">
      <label>Cargo</label>
      <select id="cargo" onchange="mudarCargo()">
        <option value="vereador">Vereador</option>
        <option value="estadual">Deputado Estadual</option>
        <option value="federal">Deputado Federal</option>
        <option value="senador">Senador (2 vagas)</option>
      </select>
    </div>
    <div class="card card-blue">
      <label>Estado</label>
      <select id="estado" onchange="mudarEstado()">
        <option value="AC">Acre</option><option value="AL">Alagoas</option>
        <option value="AM">Amazonas</option><option value="AP">Amapá</option>
        <option value="BA">Bahia</option><option value="CE">Ceará</option>
        <option value="DF">Distrito Federal</option><option value="ES">Espírito Santo</option>
        <option value="GO">Goiás</option><option value="MA">Maranhão</option>
        <option value="MG">Minas Gerais</option><option value="MS">Mato Grosso do Sul</option>
        <option value="MT">Mato Grosso</option><option value="PA">Pará</option>
        <option value="PB">Paraíba</option><option value="PE">Pernambuco</option>
        <option value="PI">Piauí</option><option value="PR">Paraná</option>
        <option value="RJ">Rio de Janeiro</option><option value="RN">Rio Grande do Norte</option>
        <option value="RO">Rondônia</option><option value="RR">Roraima</option>
        <option value="RS">Rio Grande do Sul</option><option value="SC">Santa Catarina</option>
        <option value="SE">Sergipe</option>
        <option value="SP" selected>São Paulo</option>
        <option value="TO">Tocantins</option>
      </select>
    </div>
  </div>

  <div id="vereador-box" class="card card-amber" style="margin-bottom:12px">
    <label>População do município</label>
    <input id="populacao" type="number" value="500000" oninput="calcularVereadores()">
    <div style="font-size:12px;color:#666;margin-top:4px">Vereadores calculados automaticamente pela EC 58/2009</div>
  </div>

  <div class="grid-3">
    <div class="stat-box card-orange">
      <div class="stat-label" style="color:#e65100">VAGAS</div>
      <input id="vagas" type="number" value="70" min="1" onchange="calcular()" style="width:80px;padding:6px;border:1px solid #ffcc80;border-radius:6px;font-size:20px;font-weight:800;text-align:center;color:#1a237e;margin-top:4px">
    </div>
    <div class="stat-box card-green">
      <div class="stat-label" style="color:#1b5e20">VOTOS VÁLIDOS</div>
      <input id="votos-validos" type="number" value="" placeholder="Auto" onchange="calcular()" style="width:140px;padding:6px;border:1px solid #a5d6a7;border-radius:6px;font-size:16px;font-weight:700;text-align:center;color:#1a237e;margin-top:4px">
      <div style="font-size:10px;color:#666">Deixe em branco = soma dos partidos</div>
    </div>
    <div class="stat-box card-pink">
      <div class="stat-label" style="color:#880e4f">QUOCIENTE ELEITORAL</div>
      <div class="stat-value" id="qe-display">—</div>
      <div style="font-size:10px;color:#666">votos por vaga</div>
    </div>
  </div>

  <div class="toolbar">
    <strong style="font-size:13px">📋 Partidos — Informe os votos de cada um</strong>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary" onclick="distribuir()">⚖️ Igualar</button>
      <button class="btn btn-success" onclick="exemplo()">📊 Exemplo</button>
      <button class="btn btn-danger" onclick="zerarTodos()">Zerar</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Partido</th>
          <th class="right" style="width:140px">Votos</th>
          <th class="right" style="width:55px">QP</th>
          <th class="center" style="width:50px">Sobra</th>
          <th class="right" style="width:70px">Eleitos</th>
        </tr>
      </thead>
      <tbody id="partidos-tbody"></tbody>
    </table>
  </div>

  <div id="resultado-final"></div>
</div>

<script>
// === TODOS OS 30 PARTIDOS ===
const partidos = [
  { sigla: 'MDB', nome: 'Movimento Democrático Brasileiro', votos: 0, cor: '#2e7d32' },
  { sigla: 'PDT', nome: 'Partido Democrático Trabalhista', votos: 0, cor: '#c62828' },
  { sigla: 'PT', nome: 'Partido dos Trabalhadores', votos: 0, cor: '#c62828' },
  { sigla: 'PCdoB', nome: 'Partido Comunista do Brasil', votos: 0, cor: '#b71c1c' },
  { sigla: 'PSB', nome: 'Partido Socialista Brasileiro', votos: 0, cor: '#e65100' },
  { sigla: 'PSDB', nome: 'Partido da Social Democracia Brasileira', votos: 0, cor: '#1565c0' },
  { sigla: 'AGIR', nome: 'Agir', votos: 0, cor: '#00695c' },
  { sigla: 'MOBILIZA', nome: 'Mobilização Nacional', votos: 0, cor: '#4a148c' },
  { sigla: 'CIDADANIA', nome: 'Cidadania', votos: 0, cor: '#ec407a' },
  { sigla: 'PV', nome: 'Partido Verde', votos: 0, cor: '#2e7d32' },
  { sigla: 'AVANTE', nome: 'Avante', votos: 0, cor: '#f57f17' },
  { sigla: 'PP', nome: 'Progressistas', votos: 0, cor: '#0d47a1' },
  { sigla: 'PSTU', nome: 'Partido Socialista dos Trabalhadores Unificado', votos: 0, cor: '#b71c1c' },
  { sigla: 'PCB', nome: 'Partido Comunista Brasileiro', votos: 0, cor: '#b71c1c' },
  { sigla: 'PRTB', nome: 'Partido Renovador Trabalhista Brasileiro', votos: 0, cor: '#1a237e' },
  { sigla: 'DC', nome: 'Democracia Cristã', votos: 0, cor: '#4a148c' },
  { sigla: 'PCO', nome: 'Partido da Causa Operária', votos: 0, cor: '#b71c1c' },
  { sigla: 'PODE', nome: 'Podemos', votos: 0, cor: '#ad1457' },
  { sigla: 'REPUBLICANOS', nome: 'Republicanos', votos: 0, cor: '#0d47a1' },
  { sigla: 'PSOL', nome: 'Partido Socialismo e Liberdade', votos: 0, cor: '#1b5e20' },
  { sigla: 'PL', nome: 'Partido Liberal', votos: 0, cor: '#1565c0' },
  { sigla: 'PSD', nome: 'Partido Social Democrático', votos: 0, cor: '#6a1b9a' },
  { sigla: 'SOLIDARIEDADE', nome: 'Solidariedade', votos: 0, cor: '#e65100' },
  { sigla: 'NOVO', nome: 'Partido Novo', votos: 0, cor: '#ff8f00' },
  { sigla: 'REDE', nome: 'Rede Sustentabilidade', votos: 0, cor: '#00897b' },
  { sigla: 'DEMOCRATA', nome: 'Democrata', votos: 0, cor: '#37474f' },
  { sigla: 'UP', nome: 'Unidade Popular', votos: 0, cor: '#c62828' },
  { sigla: 'UNIÃO', nome: 'União Brasil', votos: 0, cor: '#2e7d32' },
  { sigla: 'PRD', nome: 'Partido Renovação Democrática', votos: 0, cor: '#1565c0' },
  { sigla: 'MISSÃO', nome: 'Partido Missão', votos: 0, cor: '#5c6bc0' }
];

const federais = {
  AC: 8, AL: 9, AM: 8, AP: 8, BA: 39, CE: 22, DF: 8, ES: 10, GO: 17, MA: 18,
  MG: 53, MS: 8, MT: 8, PA: 17, PB: 12, PE: 25, PI: 10, PR: 30, RJ: 46, RN: 8,
  RO: 8, RR: 8, RS: 31, SC: 16, SE: 8, SP: 70, TO: 8
};

const estaduais = {
  AC: 24, AL: 27, AM: 24, AP: 24, BA: 63, CE: 46, DF: 24, ES: 30, GO: 41, MA: 42,
  MG: 77, MS: 24, MT: 24, PA: 41, PB: 36, PE: 49, PI: 30, PR: 54, RJ: 70, RN: 24,
  RO: 24, RR: 24, RS: 55, SC: 40, SE: 24, SP: 94, TO: 24
};

function vereadoresPorPopulacao(pop) {
  if (pop <= 15000) return 9;
  if (pop <= 30000) return 11;
  if (pop <= 50000) return 13;
  if (pop <= 80000) return 15;
  if (pop <= 120000) return 17;
  if (pop <= 160000) return 19;
  if (pop <= 300000) return 21;
  if (pop <= 450000) return 23;
  if (pop <= 600000) return 25;
  if (pop <= 750000) return 27;
  if (pop <= 900000) return 29;
  if (pop <= 1050000) return 31;
  if (pop <= 1200000) return 33;
  if (pop <= 1350000) return 35;
  if (pop <= 1500000) return 37;
  if (pop <= 1800000) return 39;
  if (pop <= 2400000) return 41;
  if (pop <= 3000000) return 43;
  if (pop <= 4000000) return 45;
  if (pop <= 5000000) return 47;
  if (pop <= 6000000) return 49;
  if (pop <= 7000000) return 51;
  if (pop <= 8000000) return 53;
  return 55;
}

function mudarCargo() {
  const cargo = document.getElementById('cargo').value;
  const vereadorBox = document.getElementById('vereador-box');
  const estadoSelect = document.getElementById('estado');

  if (cargo === 'vereador') {
    vereadorBox.style.display = 'block';
    estadoSelect.disabled = true;
    estadoSelect.style.opacity = '0.5';
    calcularVereadores();
  } else {
    vereadorBox.style.display = 'none';
    estadoSelect.disabled = false;
    estadoSelect.style.opacity = '1';
    mudarEstado();
  }
}

function mudarEstado() {
  const cargo = document.getElementById('cargo').value;
  const estado = document.getElementById('estado').value;
  let vagas = 2;
  if (cargo === 'federal') vagas = federais[estado] || 8;
  else if (cargo === 'estadual') vagas = estaduais[estado] || 36;
  else if (cargo === 'senador') vagas = 2;
  document.getElementById('vagas').value = vagas;
  calcular();
}

function calcularVereadores() {
  const pop = parseInt(document.getElementById('populacao').value) || 0;
  const vagas = vereadoresPorPopulacao(pop);
  document.getElementById('vagas').value = vagas;
  calcular();
}

function renderPartidos() {
  const tbody = document.getElementById('partidos-tbody');
  tbody.innerHTML = partidos.map((p, i) => `
    <tr>
      <td>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="dot" style="background:${p.cor}"></span>
          <div>
            <div class="party-sigla">${p.sigla}</div>
            <div class="party-nome">${p.nome}</div>
          </div>
        </div>
      </td>
      <td class="right">
        <input type="number" class="input-votos" value="${p.votos}" onchange="partidos[${i}].votos=parseInt(this.value)||0;calcular()">
      </td>
      <td class="right" id="qp-${i}">—</td>
      <td class="center" id="sobra-${i}">—</td>
      <td class="right" id="total-${i}">—</td>
    </tr>
  `).join('');
}

function distribuir() {
  const vagas = parseInt(document.getElementById('vagas').value) || 1;
  const totalVotosInput = document.getElementById('votos-validos').value;
  const totalVotos = totalVotosInput ? parseInt(totalVotosInput) : 50000 * partidos.length;
  const porPartido = Math.floor(totalVotos / partidos.length);
  partidos.forEach(p => p.votos = porPartido);
  renderPartidos();
  calcular();
}

function zerarTodos() {
  partidos.forEach(p => p.votos = 0);
  renderPartidos();
  calcular();
}

function exemplo() {
  const exemplos = [6200000, 5800000, 3500000, 2800000, 2200000, 1800000, 1200000, 1100000, 900000, 800000, 400000, 350000, 200000, 1500000, 600000, 500000, 450000, 400000, 350000, 300000, 250000, 200000, 180000, 150000, 120000, 100000, 80000, 70000, 50000, 30000];
  partidos.forEach((p, i) => p.votos = exemplos[i] || 0);
  renderPartidos();
  calcular();
}

function calcular() {
  const vagas = parseInt(document.getElementById('vagas').value) || 1;
  const votosValidosInput = document.getElementById('votos-validos').value;
  const somaPartidos = partidos.reduce((s, p) => s + p.votos, 0);
  const votosValidos = votosValidosInput ? parseInt(votosValidosInput) : somaPartidos;

  let qe = Math.floor(votosValidos / vagas);
  if ((votosValidos / vagas) - qe > 0.5) qe += 1;
  document.getElementById('qe-display').textContent = qe.toLocaleString('pt-BR');

  const clausula10 = Math.ceil(qe * 0.10);
  const clausula20 = Math.ceil(qe * 0.20);
  const barreiraSobra = Math.ceil(qe * 0.80);

  let distribuidas = 0;
  const dados = partidos.map((p, i) => {
    const qp = Math.floor(p.votos / qe);
    distribuidas += qp;
    return { idx: i, ...p, qp, media: p.votos / (qp + 1) };
  }).filter(p => p.votos > 0);

  const sobra = vagas - distribuidas;
  const ranking = [...dados].sort((a, b) => b.media - a.media);
  const ganharamSobra = new Set();
  for (let i = 0; i < sobra && i < ranking.length; i++) {
    if (ranking[i].votos >= barreiraSobra) {
      ganharamSobra.add(ranking[i].idx);
    }
  }

  partidos.forEach((p, i) => {
    const d = dados.find(x => x.idx === i);
    const qp = d ? d.qp : 0;
    const ganhou = ganharamSobra.has(i);
    const total = qp + (ganhou ? 1 : 0);

    document.getElementById(`qp-${i}`).textContent = qp;
    document.getElementById(`sobra-${i}`).innerHTML = ganhou ? '<span class="sobra-sim">✓</span>' : '—';
    const el = document.getElementById(`total-${i}`);
    el.textContent = total;
    el.className = total > 0 ? 'right eleitos' : 'right eleitos-zero';
  });

  const totalEleitos = dados.reduce((s, d) => s + d.qp + (ganharamSobra.has(d.idx) ? 1 : 0), 0);
  const pctVotos = votosValidos > 0 ? ((somaPartidos / votosValidos) * 100).toFixed(1) : '100';

  document.getElementById('resultado-final').innerHTML = `
    <div class="result-grid">
      <div class="result-card" style="background:#e8f5e9;border-color:#2e7d32">
        <h4 style="color:#1b5e20">✅ Cláusula Individual</h4>
        <p style="color:#2e7d32">Vaga de QP: ≥ <strong>${clausula10.toLocaleString('pt-BR')}</strong> votos (10% do QE)</p>
        <p style="color:#2e7d32">Vaga de sobra: ≥ <strong>${clausula20.toLocaleString('pt-BR')}</strong> votos (20% do QE)</p>
      </div>
      <div class="result-card" style="background:#fff3e0;border-color:#ef6c00">
        <h4 style="color:#e65100">📌 Regras da Sobra</h4>
        <p style="color:#bf360c">Disputar sobra: ≥ <strong>${barreiraSobra.toLocaleString('pt-BR')}</strong> votos (80% do QE)</p>
        <p style="color:#bf360c">Sobras distribuídas: <strong>${Math.min(sobra, [...ganharamSobra].length)}</strong> de <strong>${sobra}</strong></p>
      </div>
    </div>
    <div class="summary">
      <div style="font-size:13px;opacity:0.9">RESUMO</div>
      <h3>${totalEleitos} de ${vagas} vagas preenchidas</h3>
      <small>QE = ${qe.toLocaleString('pt-BR')} votos · Votos informados: ${somaPartidos.toLocaleString('pt-BR')} (${pctVotos}% dos válidos)</small>
    </div>
  `;
}

renderPartidos();
mudarCargo();
</script>
</body>
</html>